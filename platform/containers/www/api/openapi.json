    "/terraform/v1/mgmt/streams/query": {
      "post": {
        "operationId": "mgmt_streams_query",
        "tags": [
          "streams"
        ],
        "summary": "查詢 SRS 串流與生命週期事件",
        "description": "帶 vhost/app/stream 可精確查單路；不帶則回傳全部。events 是發布／取消／踢除紀錄（播放事件另存）。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "vhost": {
                    "type": "string"
                  },
                  "app": {
                    "type": "string"
                  },
                  "stream": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "token": "<API token>"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功；`code` 非 0 表示錯誤，`data` 的形狀見 schema。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "streams": {},
                            "events": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "client": {
                                    "type": "string"
                                  },
                                  "durationSec": {
                                    "type": "string"
                                  },
                                  "event": {
                                    "type": "string"
                                  },
                                  "ip": {
                                    "type": "string"
                                  },
                                  "stream": {
                                    "type": "string"
                                  },
                                  "time": {
                                    "type": "string"
                                  },
                                  "note": {
                                    "type": "string"
                                  }
                                }
                              }
                            },
                            "viewerEvents": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "client": {
                                    "type": "string"
                                  },
                                  "event": {
                                    "type": "string"
                                  },
                                  "ip": {
                                    "type": "string"
                                  },
                                  "stream": {
                                    "type": "string"
