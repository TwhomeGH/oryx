                                },
                                "endedAt": {
                                  "type": "number"
                                },
                                "normalize": {
                                  "type": "boolean"
                                }
                              }
                            },
                            "forwarding-rstream": {
                              "type": "object",
                              "properties": {
                                "platform": {
                                  "type": "string"
                                },
                                "stream": {
                                  "type": "string"
                                },
                                "server": {
                                  "type": "string"
                                },
