{
  "openapi": "3.0.3",
  "info": {
    "title": "Oryx 維運 API",
    "version": "v5.22.12",
    "description": "平台維運端點的規格。完整端點清單見 docs/api-reference.md；本規格只涵蓋實際會用到的部分，schema 由真實回應推導。"
  },
  "servers": [
    {
      "url": "http://localhost:882",
      "description": "本機預設埠"
    }
  ],
  "tags": [
    {
      "name": "forward",
      "description": "多平台轉播：目標設定、狀態、指標與執行紀錄。"
    },
    {
      "name": "streams",
      "description": "SRS 串流狀態與生命週期事件。"
    },
    {
      "name": "record",
      "description": "錄影（DVR）狀態。"
    },
    {
      "name": "system",
      "description": "平台自身的磁碟、GPU、SRS 日誌健康與版本資訊。"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization: Bearer <API token>；也接受 body 內的 token 欄位。"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "token 缺少或不正確。"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "0 表示成功。"
          },
          "server": {
            "type": "string",
            "description": "Oryx/<version>"
          }
        },
        "required": [
          "code"
        ]
      }
    }
  },
  "paths": {
    "/terraform/v1/ffmpeg/forward/streams": {
      "post": {
        "operationId": "ffmpeg_forward_streams",
        "tags": [
          "forward"
        ],
        "summary": "列出轉播目標與即時狀態",
        "description": "回傳每個目標的狀態、指標、事件時間線與近期日誌。`stream` 是目標自己的輸出串流（本機目標會顯示，外部平台不含 secret）。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "API token（也可改用 Authorization: Bearer）。"
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "query"
                    ],
                    "description": "預設 query。"
                  }
                }
              },
              "example": {
                "token": "<API token>"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功；`code` 非 0 表示錯誤，`data` 的形狀見 schema。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "consecutiveFailures": {
                                "type": "number"
                              },
                              "custom": {
                                "type": "boolean"
                              },
                              "enabled": {
                                "type": "boolean"
                              },
                              "encoder": {
                                "type": "string"
                              },
                              "events": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "at": {
                                      "type": "string"
                                    },
                                    "name": {
                                      "type": "string"
                                    },
                                    "detail": {
                                      "type": "string"
                                    }
                                  }
                                }
                              },
                              "ffmpegArgs": {
                                "type": "string"
                              },
                              "label": {
                                "type": "string"
                              },
                              "loopExitReason": {
                                "type": "string"
                              },
                              "loopPhase": {
                                "type": "string"
                              },
                              "loopRunning": {
                                "type": "boolean"
                              },
                              "loopUpdated": {
                                "type": "string"
                              },
                              "normalize": {
                                "type": "boolean"
                              },
                              "platform": {
                                "type": "string"
                              },
                              "programSwitches": {
                                "type": "number"
                              },
                              "restartCount": {
                                "type": "number"
                              },
                              "status": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "data": [
                    {
                      "consecutiveFailures": 0,
                      "custom": true,
                      "enabled": false,
                      "encoder": "copy",
                      "events": [
                        {
                          "at": "2026-11-20T22:53:01Z",
                          "name": "loop-start",
                          "detail": "initializing"
                        }
                      ],
                      "ffmpegArgs": "-reconnect 1 -reconnect_at_eof 1 -reconnect_streamed 1 -reconnect_on_http_error 4xx,5xx -reconnect_delay_max 5 -i http://localhost:2022/live/__forward_<source>.flv -c copy -max_interleave_delta 0 -f flv rtmp://<platform>/%3Capp%3E/%2A%2A%2A   (預覽：尚未啟動)",
                      "label": "TEST clean",
                      "loopExitReason": "",
                      "loopPhase": "poll-wait",
                      "loopRunning": true,
                      "loopUpdated": "2026-11-21T03:13:34Z",
                      "normalize": false,
                      "platform": "forwarding-clean-keep",
                      "programSwitches": 0,
                      "restartCount": 0,
                      "status": "idle"
                    },
                    {
                      "consecutiveFailures": 0,
                      "custom": true,
                      "enabled": false,
                      "encoder": "copy",
                      "events": [
                        {
                          "at": "2026-11-20T22:53:01Z",
                          "name": "loop-start",
                          "detail": "initializing"
                        }
                      ],
                      "ffmpegArgs": "-reconnect 1 -reconnect_at_eof 1 -reconnect_streamed 1 -reconnect_on_http_error 4xx,5xx -reconnect_delay_max 5 -i http://localhost:2022/live/__forward_<source>.flv -c copy -max_interleave_delta 0 -f flv rtmp://<platform>/%3Capp%3E/%2A%2A%2A   (預覽：尚未啟動)",
                      "label": "TEST obs",
                      "loopExitReason": "",
                      "loopPhase": "poll-wait",
                      "loopRunning": true,
                      "loopUpdated": "2026-11-21T03:13:34Z",
                      "normalize": false,
                      "platform": "forwarding-obs-test",
                      "programSwitches": 0,
                      "restartCount": 0,
                      "status": "idle"
                    }
                  ],
                  "server": "Oryx/v5.22.12"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/terraform/v1/ffmpeg/forward/secret": {
      "post": {
        "operationId": "ffmpeg_forward_secret",
        "tags": [
          "forward"
        ],
        "summary": "查詢／修改轉播目標",
        "description": "省略 action 等同查詢全部目標。`metrics`／`sessions`／`timing` 只讀，需要 `platform`；其餘動作需要完整目標設定。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "update",
                      "delete",
                      "toggle",
                      "end",
                      "cancel-end",
                      "metrics",
                      "sessions",
                      "timing"
                    ]
                  },
                  "platform": {
                    "type": "string",
                    "description": "目標 key；自訂目標為 forwarding-<slug>。"
                  },
                  "stream": {
                    "type": "string",
                    "description": "來源串流（留空表示自動選擇）。"
                  },
                  "server": {
                    "type": "string",
                    "description": "rtmp(s)://host/app/ 形式的伺服器位址。"
                  },
                  "secret": {
                    "type": "string",
                    "description": "目標的串流金鑰；本機目標可帶 ?secret=。"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "custom": {
                    "type": "boolean",
                    "description": "內建平台不可設為 true。"
                  },
                  "label": {
                    "type": "string",
                    "description": "對外顯示名稱；必須與 platform 一致（forwarding-<slug>）。"
                  },
                  "failover": {
                    "type": "string",
                    "enum": [
                      "hold",
                      "slate"
                    ],
                    "description": "hold 凍結最後一格（零空窗）；slate 顯示備援畫面（會重新編碼）。"
                  },
                  "normalize": {
                    "type": "boolean",
                    "description": "已由全域設定取代，保留相容。"
                  },
                  "ended": {
                    "type": "boolean"
                  },
                  "endedAt": {
                    "type": "integer",
                    "format": "int64"
                  }
                }
              },
              "example": {
                "token": "<API token>",
                "action": "（省略）"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功；`code` 非 0 表示錯誤，`data` 的形狀見 schema。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "forwarding-clean-keep": {
                              "type": "object",
                              "properties": {
                                "platform": {
                                  "type": "string"
                                },
                                "stream": {
                                  "type": "string"
                                },
                                "server": {
                                  "type": "string"
                                },
                                "secret": {
                                  "type": "string"
                                },
                                "enabled": {
                                  "type": "boolean"
                                },
                                "custom": {
                                  "type": "boolean"
                                },
                                "label": {
                                  "type": "string"
                                },
                                "failover": {
                                  "type": "string"
                                },
                                "ended": {
                                  "type": "boolean"
                                },
                                "endedAt": {
                                  "type": "number"
                                },
                                "normalize": {
                                  "type": "boolean"
                                }
                              }
                            },
                            "forwarding-obs-test": {
                              "type": "object",
                              "properties": {
                                "platform": {
                                  "type": "string"
                                },
                                "stream": {
                                  "type": "string"
                                },
                                "server": {
                                  "type": "string"
                                },
                                "secret": {
                                  "type": "string"
                                },
                                "enabled": {
