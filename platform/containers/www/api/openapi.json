                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "x-actions": [
          {
            "action": "（省略）",
            "description": "查詢全部目標設定，回傳 platform → 設定的物件。"
          },
          {
            "action": "update",
            "description": "新增或更新目標；platform 為自訂目標時 key 由 label 推導（forwarding-<slug>）。"
          },
          {
            "action": "delete",
            "description": "刪除目標，同時清掉它的指標與執行紀錄，並踢除 SRS 發佈者。"
          },
          {
            "action": "toggle",
            "description": "切換 enabled；不影響其他目標。"
          },
          {
            "action": "end",
            "description": "手動結束直播：composite 顯示結束畫面並在寬限後停止，hold 立即停止。"
          },
          {
            "action": "cancel-end",
            "description": "取消結束直播，恢復目標。"
          },
          {
            "action": "metrics",
            "description": "本次執行的取樣歷史（5 秒一筆，最多 720 筆）。"
          },
          {
            "action": "sessions",
            "description": "最近 10 場執行紀錄（含進行中的那一場）。"
          },
          {
            "action": "timing",
            "description": "來源時間軸側錄清單（每個 platform 保留最近 5 次）。"
          }
        ]
      }
