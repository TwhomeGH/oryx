    "/terraform/v1/mgmt/record/query": {
      "post": {
        "operationId": "mgmt_record_query",
        "tags": [
          "record"
        ],
        "summary": "查詢錄影狀態",
        "description": "回傳進行中與已完成的錄影，以及判定為異常的原因。錄影由 SRS 的 on_hls 事件驅動，HLS 關閉時不會產生檔案。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string"
                  }
                }
              },
